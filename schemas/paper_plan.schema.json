          "title": "Detail Kind",
          "type": "string"
        },
        "basis": {
          "enum": [
            "document_extracted",
            "document_derived",
            "domain_default",
            "engineering_choice",
            "user_environment",
            "user_decision",
            "user_confirmation_required",
            "document_claim_unverified"
