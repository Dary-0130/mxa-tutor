        "obligation_kind": {
          "anyOf": [
            {
              "enum": [
                "determine_parameter_value",
                "select_component",
                "configure_setting",
                "connect_signal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obligation Kind"
        },
        "resolution": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "conditional": "#/$defs/ConditionalResolutionModel",
                  "derivation": "#/$defs/DerivationResolutionModel",
                  "enum_selection": "#/$defs/EnumSelectionResolutionModel",
                  "environment_probe": "#/$defs/EnvironmentProbeResolutionModel",
                  "fixed": "#/$defs/FixedResolutionModel",
                  "guided_user_decision": "#/$defs/GuidedUserDecisionResolutionModel",
                  "range": "#/$defs/RangeResolutionModel"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/FixedResolutionModel"
                },
                {
                  "$ref": "#/$defs/RangeResolutionModel"
                },
                {
                  "$ref": "#/$defs/EnumSelectionResolutionModel"
                },
                {
                  "$ref": "#/$defs/DerivationResolutionModel"
                },
                {
                  "$ref": "#/$defs/ConditionalResolutionModel"
                },
                {
                  "$ref": "#/$defs/GuidedUserDecisionResolutionModel"
                },
                {
                  "$ref": "#/$defs/EnvironmentProbeResolutionModel"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "execution_closure": {
          "default": "open",
          "enum": [
            "closed",
            "guided_choice",
            "guided_probe",
            "open"
          ],
          "title": "Execution Closure",
          "type": "string"
        },
        "input_fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Fact Refs",
          "type": "array"
        },
        "punt_reason_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Punt Reason Code"
        }
      },
      "required": [
        "detail_id",
        "step_id",
        "detail_kind",
        "basis",
        "actionability",
        "display_text",
        "evidence",
        "convention_code",
        "confirmation_reason_code"
      ],
      "title": "GuidanceDetailModel",
      "type": "object"
    },
