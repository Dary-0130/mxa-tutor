        "result": {
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "result",
        "action"
      ],
      "title": "EnvironmentProbeActionModel",
