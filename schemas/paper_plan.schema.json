        },
        "probe_item": {
          "minLength": 1,
          "title": "Probe Item",
          "type": "string"
        },
        "procedure": {
          "minLength": 1,
          "title": "Procedure",
          "type": "string"
        },
        "result_actions": {
          "items": {
            "$ref": "#/$defs/EnvironmentProbeActionModel"
          },
          "title": "Result Actions",
          "type": "array"
        }
