    "EvidenceSource": {
      "description": "Source marker for paper-to-model evidence.",
      "enum": [
        "document_extracted",
        "user_supplied"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "FixedBlockRefResolutionModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        },
        "fixed_kind": {
          "const": "block_ref",
          "title": "Fixed Kind",
          "type": "string"
        },
        "selected_id": {
          "minLength": 1,
          "title": "Selected Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fixed_kind",
        "selected_id"
      ],
      "title": "FixedBlockRefResolutionModel",
      "type": "object"
    },
    "FixedConfigurationOptionResolutionModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        },
        "fixed_kind": {
          "const": "configuration_option",
          "title": "Fixed Kind",
          "type": "string"
        },
        "value_token": {
          "pattern": "^[A-Za-z0-9]{1,40}$",
          "title": "Value Token",
          "type": "string"
        },
        "display_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fixed_kind",
        "value_token",
        "display_label"
      ],
      "title": "FixedConfigurationOptionResolutionModel",
      "type": "object"
    },
    "FixedConnectionModeResolutionModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        },
        "fixed_kind": {
          "const": "connection_mode",
          "title": "Fixed Kind",
          "type": "string"
        },
        "value_token": {
          "pattern": "^[A-Za-z0-9]{1,40}$",
          "title": "Value Token",
          "type": "string"
        },
        "display_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fixed_kind",
        "value_token",
        "display_label"
      ],
      "title": "FixedConnectionModeResolutionModel",
      "type": "object"
    },
    "FixedNumericResolutionModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        },
        "fixed_kind": {
          "const": "numeric",
          "title": "Fixed Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fixed_kind",
        "value",
        "unit"
      ],
      "title": "FixedNumericResolutionModel",
      "type": "object"
    },
    "FixedResolutionModel": {
      "description": "OpenAPI-safe fixed wrapper that preserves the flat public JSON shape.",
      "discriminator": {
        "mapping": {
          "block_ref": "#/$defs/FixedBlockRefResolutionModel",
          "configuration_option": "#/$defs/FixedConfigurationOptionResolutionModel",
          "connection_mode": "#/$defs/FixedConnectionModeResolutionModel",
          "numeric": "#/$defs/FixedNumericResolutionModel"
        },
        "propertyName": "fixed_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixedNumericResolutionModel"
        },
        {
          "$ref": "#/$defs/FixedBlockRefResolutionModel"
        },
        {
          "$ref": "#/$defs/FixedConfigurationOptionResolutionModel"
        },
        {
          "$ref": "#/$defs/FixedConnectionModeResolutionModel"
        }
      ],
      "title": "FixedResolutionModel"
    },
    "GuidanceAssessmentModel": {
      "additionalProperties": false,
      "properties": {
        "content_status": {
          "enum": [
            "reproducible_candidate",
            "outline_with_gaps",
            "outline_only"
          ],
          "title": "Content Status",
          "type": "string"
        },
        "environment_status": {
          "enum": [
            "not_checked",
            "compatible",
            "missing_toolbox",
            "incompatible"
          ],
          "title": "Environment Status",
          "type": "string"
        },
        "overall_status": {
          "enum": [
            "reproducible_ready",
            "reproducible_candidate_env_unchecked",
            "outline_with_gaps",
            "outline_only"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "blocking_gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Gap Ids",
          "type": "array"
        },
        "pending_user_choice_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pending User Choice Count",
          "type": "integer"
        },
        "pending_environment_probe_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pending Environment Probe Count",
          "type": "integer"
        },
        "open_requirement_count": {
          "default": 0,
          "minimum": 0,
          "title": "Open Requirement Count",
          "type": "integer"
        }
      },
      "required": [
        "content_status",
        "environment_status",
        "overall_status",
        "blocking_gap_ids"
      ],
      "title": "GuidanceAssessmentModel",
      "type": "object"
    },
    "GuidanceDetailModel": {
      "additionalProperties": false,
