        "evidence": {
          "items": {
            "$ref": "#/$defs/PaperEvidenceEntryModel"
          },
          "title": "Evidence",
          "type": "array"
        },
        "convention_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Convention Code"
        },
        "confirmation_reason_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmation Reason Code"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuidanceTargetModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
