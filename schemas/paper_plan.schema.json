        "exhaustive": {
          "default": false,
          "title": "Exhaustive",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "branches"
      ],
      "title": "ConditionalResolutionModel",
      "type": "object"
    },
    "ConfigurationHintModel": {
