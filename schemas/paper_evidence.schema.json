{
  "$defs": {
    "EvidenceSource": {
      "description": "Source marker for paper-to-model evidence.",
      "enum": [
        "document_extracted",
        "user_supplied"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "UserEvidenceAction": {
      "description": "Action represented by a user-supplied evidence entry.",
      "enum": [
        "fill_missing",
        "correct_extracted"
      ],
      "title": "UserEvidenceAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/EvidenceSource"
    },
    "document_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^DOC-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Document Id"
    },
    "paper_section_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paper Section Id"
    },
    "equation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equation Id"
    },
    "figure_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Figure Id"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "missing_param_prompt_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Param Prompt Id"
    },
    "user_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserEvidenceAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameter_correction_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Correction Id"
    },
    "correction_param_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Param Key"
    }
  },
  "required": [
    "source",
    "document_id"
  ],
  "title": "PaperEvidenceEntryModel",
  "type": "object"
}
