      "enum": [
        "completed",
        "stopped",
        "execution_error",
        "unknown"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "convergence_status": {
      "enum": [
        "converged",
        "not_converged",
        "not_applicable",
        "unknown"
      ],
      "title": "Convergence Status",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "solver": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solver"
    },
    "metrics_status": {
      "enum": [
        "available",
        "unavailable",
        "not_applicable",
        "unknown"
