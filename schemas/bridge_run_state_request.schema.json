    "series": {
      "items": {
        "discriminator": {
          "mapping": {
            "identity_uniform_v1": "#/$defs/BridgeRunStateIdentitySeriesModel",
            "min_max_envelope_uniform_v1": "#/$defs/BridgeRunStateEnvelopeSeriesModel"
