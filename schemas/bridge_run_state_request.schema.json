{
  "$defs": {
    "BridgeRunStateEnvelopeSeriesModel": {
      "additionalProperties": false,
      "properties": {
        "representation": {
          "const": "min_max_envelope_uniform_v1",
          "title": "Representation",
          "type": "string"
        },
        "series_id": {
          "pattern": "^[A-Za-z0-9._\\-]{1,32}$",
          "title": "Series Id",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "time_unit": {
          "enum": [
            "s",
            "ms",
            "us",
            "unknown"
          ],
          "title": "Time Unit",
          "type": "string"
        },
        "value_unit_status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ],
          "title": "Value Unit Status",
          "type": "string"
        },
        "sample_order": {
          "const": "chronological",
          "title": "Sample Order",
          "type": "string"
        },
        "source_point_count": {
          "exclusiveMinimum": 192,
          "title": "Source Point Count",
          "type": "integer"
        },
        "t_start": {
          "title": "T Start",
          "type": "number"
        },
        "bucket_width": {
          "exclusiveMinimum": 0,
          "title": "Bucket Width",
          "type": "number"
        },
        "y_min": {
          "items": {
            "type": "number"
          },
          "maxItems": 96,
          "minItems": 96,
          "title": "Y Min",
          "type": "array"
        },
        "y_max": {
          "items": {
            "type": "number"
          },
          "maxItems": 96,
          "minItems": 96,
          "title": "Y Max",
          "type": "array"
        },
        "value_unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Unit"
        }
      },
      "required": [
        "representation",
        "series_id",
        "label",
        "time_unit",
        "value_unit_status",
        "sample_order",
        "source_point_count",
        "t_start",
        "bucket_width",
        "y_min",
        "y_max"
      ],
      "title": "BridgeRunStateEnvelopeSeriesModel",
      "type": "object"
    },
    "BridgeRunStateIdentitySeriesModel": {
