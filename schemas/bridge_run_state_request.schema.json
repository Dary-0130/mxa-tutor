  "required": [
    "protocol_version",
    "request_id",
    "session_id",
    "run_id",
    "run_sequence",
    "matlab_release",
    "client_version",
    "run_state_sharing_consent_confirmed",
    "run_status",
    "convergence_status",
    "metrics_status",
    "metrics",
    "series_status",
