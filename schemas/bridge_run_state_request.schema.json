      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "run_sequence": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Run Sequence",
      "type": "integer"
    },
    "matlab_release": {
      "pattern": "^R20[0-9]{2}[ab]$",
      "title": "Matlab Release",
      "type": "string"
    },
    "client_version": {
      "pattern": "^[A-Za-z0-9.\\-]{1,32}$",
      "title": "Client Version",
      "type": "string"
    },
