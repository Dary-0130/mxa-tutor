# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database
DB_PATH=./data/mxa.db

# Storage
UPLOAD_DIR=./data/uploads
UPLOAD_TTL_HOURS=24

# Limits
MAX_UPLOAD_SIZE_MB=50
MAX_SINGLE_FILE_MB=20
MAX_FILES_PER_PROJECT=200
MAX_COMPRESSION_RATIO=100
FREE_QUESTION_PER_PROJECT=3
SINGLE_PACK_QUOTA=100
MONTHLY_QUOTA=300

# Limits(TASK-104 扩展)
MAX_EXTRACTION_SECONDS=30
MAX_TOTAL_UNCOMPRESSED_MB=200
MAX_ENTRIES_PER_PROJECT=200

# Embedding(TASK-301 新增)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true

# Vector(TASK-302 新增)
VECTOR_TOP_K=8
VECTOR_MIN_SCORE=0.3

# RAG retrieval(TASK-304 新增)
RAG_MIN_CHUNK_COUNT=1

# Chunking(TASK-303 新增)
CHUNKING_MAX_SOURCE_TEXT_CHARS=1024
CHUNKING_DOCSTRING_MAX_CHARS=300
CHUNKING_PARAM_VALUE_MAX_CHARS=80
CHUNKING_MAX_PARAMS_PER_BLOCK=12
CHUNKING_MAX_SUBSYSTEM_CHILD_BLOCK_NAMES=20
CHUNKING_DESCRIPTION_MAX_CHARS=300

# Logging
LOG_LEVEL=INFO

# Runtime environment
APP_ENV=production

# MATLAB bridge(TASK-510; only enable in APP_ENV=development/test)
MATLAB_BRIDGE_ENABLED=false
MATLAB_ENGINE_ENABLED=false
MATLAB_BRIDGE_AUTH_SIGNING_KEY=replace-with-local-dev-test-secret-at-least-32-bytes
MATLAB_BRIDGE_AUTH_KEY_ID=mxa-bridge-dev-v1
MATLAB_BRIDGE_AUTH_ISSUER=mxa-tutor-dev
MATLAB_BRIDGE_AUTH_AUDIENCE=mxa-matlab-bridge
MATLAB_BRIDGE_AUTH_TOKEN_TTL_SECONDS=300
MATLAB_BRIDGE_AUTH_MAX_LIFETIME_SECONDS=900
MATLAB_BRIDGE_AUTH_CLOCK_SKEW_SECONDS=10
MATLAB_BRIDGE_WORKER_COUNT=1
MATLAB_BRIDGE_INSTANCE_COUNT=1
MATLAB_BRIDGE_DEV_AUTH_ENABLED=false
MATLAB_BRIDGE_DEV_AUTH_BOOTSTRAP_TOKEN=replace-with-local-dev-test-bootstrap-token-32-bytes
